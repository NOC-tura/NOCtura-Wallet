{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "jest"]
  },
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/sdk" },
    { "path": "packages/zk-proofs" },
    { "path": "packages/mixing" },
    { "path": "packages/compliance" },
    { "path": "packages/ui-components" },
    { "path": "backend/api-server" },
    { "path": "backend/prover-service" },
    { "path": "apps/browser-extension" }
  ]
}
